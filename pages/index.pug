extends ../components/common/pug/_layout.pug
include ../components/common/pug/_mixins.pug

block links
    link(rel="stylesheet", href="css/index.css")

block content


    section.main
        div.container
            h1 Русификация и обновление навигации для Lexus и Toyota
            hr.divide
            div.group
                span Профессиональная установка мультимедийных систем с полной русификацией интерфейса и актуальными картами навигации для автомобилей из #[b Кореи, Китая, ОАЭ, Японии и США.]
                a(href="#").button Подобрать по авто

        //- img(src="images/main_background.webp").background
        video(src="images/hero.mp4" muted autoplay loop playsinline)
        
        div.dots.left.bottom
            include ../images/pattern.svg
        div.dots.right.top
            include ../images/pattern.svg

    include ../components/sections/_services.pug
    include ../components/sections/_digits.pug
    include ../components/sections/_advantages.pug

    section.example
        div.container
            div.text
                h2 Пример нашей работы
                span Каждая установка выполняется с точностью мастера. Видите результат, который получают наши клиенты.
            div.video
                video(src="images/video.mp4", poster="images/example_video_preview.webp")
                div.play
                    include ../images/play.svg

    include ../components/sections/_decision.pug
    include ../components/sections/_navigation.pug
