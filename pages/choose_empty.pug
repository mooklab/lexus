extends ../components/common/pug/_layout.pug
include ../components/common/pug/_mixins.pug

block links
    link(rel="stylesheet", href="css/choose.css")

block content

    section.main.padding
        div.container
            div.breadcrumbs
                a(href="#") Главная
                span.divide /
                span Подбор по авто

            div.text
                h2 Подбор услуг по автомобилю
                span Выберите марку, модель и комплектацию — покажем, что можем сделать именно для вашей машины

            form(tabindex="1")
                div.select
                    span Марка
                    div.radios
                        label.radio
                            input(type="radio", name="mark", checked)
                            div.logotype
                                include ../images/lexus.svg
                        label.radio
                            input(type="radio", name="mark")
                            div.logotype
                                include ../images/toyota.svg
                div.select
                    span Модель
                    +select('model', 'Выберите', 'Lexus', 'Toyota')
                div.select
                    span Год выпуска
                    +select('year', 'Выберите', '2000', '2001', '2002', '2003', '2004', '2005', '2006', '2007', '2008', '2009', '2010', '2011', '2012', '2013', '2014', '2015')
                div.select
                    span Страна производства
                    +select('country', 'Выберите', 'Япония', 'Россия', 'Америка')

        img(src="images/choose_background.webp").background

    section.results.padding
        div.container
            div.empty
                h3 К сожалению, по вашему запросу услуг не найдено
                span.note Lexus ES 200 · 2025 · Китай
                span Возможно, для этой комплектации услуга ещё не добавлена в базу, или у нас есть решение, которого нет в каталоге. Позвоните — разберёмся.


    include ../components/sections/_consulting_3.pug