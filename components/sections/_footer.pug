footer
    div.container

        div.top

            a(href="#").logotype
                img(src="images/logotype.svg", alt="Lexus-Navi")

            div.menus
                div.services
                    div(onclick="this.parentNode.classList.toggle('open')").title
                        h4 Услуги
                        img(src="images/footer_arrow.svg")
                    div.menu
                        div.overflow
                            div.list
                                a(href="#") Русификация Lexus / Toyota
                                a(href="#") Ремонт мультимедиа Lexus / Toyota
                                a(href="#") Установка противоугонного комплекса
                                a(href="#") Шумоизоляция автомобиля
                                a(href="#") Компьютерная диагностика
                                a(href="#") Чип-тюнинг
                                a(href="#") Установка Android систем
                                a(href="#") Активация CarPlay

                div.more
                    div(onclick="this.parentNode.classList.toggle('open')").title
                        h4 Сервисы и контакты
                        img(src="images/footer_arrow.svg")
                    div.menu
                        div.overflow
                            div.list
                                a(href="#") Подбор по авто
                                a(href="#") Контакты

            div.socials
                h4 Соцсети
                a(href="#") 
                    include ../../images/footer_telegram.svg
                    | Telegram
                a(href="#") 
                    include ../../images/footer_rutube.svg
                    | RuTube
                a(href="#") 
                    include ../../images/footer_avito.svg
                    | Avito

            div.contacts
                a(href="#") 
                    include ../../images/footer_phone.svg
                    | +7 (495) 150-60-70
                a(href="#") 
                    include ../../images/footer_email.svg
                    | info@lexus-navi.ru
                span 
                    img(src="images/footer_pin.svg")
                    | г. Москва, 3-й Угрешский проезд, 8а стр. 3

            img(src="images/scroll_top.svg", onclick="window.scrollTo(0, 0);").scroll_top

        div.bottom
            span © 2025 Lexus-Navi. Все права защищены.
            a(href="#") Настройки cookies
            a(href="#") Условия использования
            a(href="#") Политика конфиденциальности
            a(href="#").develop
                span Дизайн, разработка сайта
                img(src="images/mwi.svg", alt="MWI")

        img(src="images/footer_background.webp").background

div#cookie-banner
    span Продолжая навигацию по сайту, вы соглашаетесь с #[a(href="#") правилами использования cookie-файлов]
    button#accept-cookies Согласен