section.consulting
    div.container
        div.text
            h2 Не нашли то, что искали?
            span Позвоните нам — уточним, работаем ли с вашим автомобилем и что можем сделать
        div.phone
            a(href="#").phone 
                img(src="images/consulting_phone.svg")
                span +7 (495) 150-60-70
            span.schedule Пн–Вс, 9:00–19:00

        img(src="images/consulting_hand.webp").hand
        img(src="images/consulting_background.webp").background

        div.dots.left.top
            include ../../images/pattern.svg
        div.dots.right.bottom
            include ../../images/pattern.svg