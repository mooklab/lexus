section.decision
    div.container

        div.text
            h2 Мы вникаем в задачу и помогаем найти решение
            span Поэтому с нами можно быстро обсудить вопрос и получить понятную поддержку
        
        div.grid
            div.contacts
                h3 Способы связи
                div.list
                    div.contact
                        div.icon
                            img(src="images/decision_phone.svg")
                        div.description
                            span Телефон
                            a(href="#"): h4 +7 (495) 150-60-70
                    div.contact
                        div.icon
                            img(src="images/decision_phone_mobile.svg")
                        div.description
                            span Телефон мобильный
                            a(href="#"): h4 +7 (916) 888-80-00
                    div.contact
                        div.icon
                            img(src="images/decision_email.svg")
                        div.description
                            span Email
                            a(href="#"): h4 info@lexus-navi.ru
                    div.contact
                        div.icon
                            img(src="images/decision_pin.svg")
                        div.description
                            span Офис
                            h4 г. Москва, 3-й Угрешский проезд 8а, стр.3
                img(src="images/decision_background.webp").background

            div.map
                iframe(
                    src="https://yandex.ru/map-widget/v1/?um=constructor%3A3a68fd6473f89a894f39d13ec99479672416507740cdfd56a6d87b53b3694853&amp;source=constructor" 
                    width="100%" 
                    height="100%" 
                    frameborder="0"
                )
        div.dots.right.top
            include ../../images/pattern.svg